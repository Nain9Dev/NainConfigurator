{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": ["vite.config.ts", "playwright.config.ts", "e2e"]
}
